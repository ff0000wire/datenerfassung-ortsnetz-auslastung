# Pflicht: Koordinaten des Messorts.
ORTSNETZ_LATITUDE=
ORTSNETZ_LONGITUDE=

ORTSNETZ_BROKER_URL=mqtt://broker.local:1883
ORTSNETZ_USERNAME=
ORTSNETZ_PASSWORD=

# Spannung je Phase in V. Bei einphasiger Messung L2 und L3 leer lassen.
ORTSNETZ_L1_TOPIC=mbmd/sdm1-1/Voltage/L1
ORTSNETZ_L2_TOPIC=mbmd/sdm1-1/Voltage/L2
ORTSNETZ_L3_TOPIC=mbmd/sdm1-1/Voltage/L3
ORTSNETZ_FREQUENCY_TOPIC=mbmd/sdm1-1/Frequency
# ORTSNETZ_JSON_KEY=value

# Optional, nur Werte des Hausanschlusses.
# ORTSNETZ_GRID_POWER_TOPIC=
# ORTSNETZ_GRID_POWER_INVERT=false
# ORTSNETZ_APPARENT_POWER_TOPIC=
# ORTSNETZ_POWER_FACTOR_TOPIC=
# ORTSNETZ_L1_CURRENT_TOPIC=
# ORTSNETZ_L2_CURRENT_TOPIC=
# ORTSNETZ_L3_CURRENT_TOPIC=
# ORTSNETZ_BATTERY_SOC_TOPIC=
# ORTSNETZ_SOLAR_FORECAST_TOPIC=evcc/site/forecast/solar

# Statische Angaben, werden nach jedem Start einmal gesendet.
# ORTSNETZ_SMARTMETER_MODEL=Eastron SDM630
# ORTSNETZ_PLANT_CAPACITY_KWP=
# ORTSNETZ_BATTERY_CAPACITY_KWH=
